{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Signage_Recce (Chrome 5050)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port=5050"]
    },
    {
      "name": "Signage_Recce (Phone LAN)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=API_BASE_URL=http://192.168.1.43:4000/api/v1",
        "--target-platform=android-arm64"
      ]
    }
  ]
}
